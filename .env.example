# ---- Database (Postgres + pgvector) ----
POSTGRES_USER=odin
POSTGRES_PASSWORD=odin
POSTGRES_DB=odin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async SQLAlchemy URL (asyncpg). Overrides the parts above if set.
DATABASE_URL=postgresql+asyncpg://odin:odin@localhost:5432/odin

# ---- Redis (ARQ queue) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- LLM provider (DeepSeek via OpenAI-compatible API) ----
# Provider abstraction default is DeepSeek. Swap base_url/model for OpenAI or a local model.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Only events at/above this trend score get LLM enrichment (cost control).
ENRICH_TREND_THRESHOLD=50

# ---- Embeddings (local sentence-transformers, no API key) ----
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# "local" = sentence-transformers (needs `uv sync --extra ml`); "hash" = deterministic fallback (no torch)
EMBEDDING_BACKEND=local

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Comma-separated origins allowed by CORS (Next.js dev server, etc.)
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
