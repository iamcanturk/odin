# Copy to /home/odin/app/.env on the server and fill in. NEVER commit the real .env.

# ---- Database (Dockerized Postgres+pgvector, localhost only) ----
POSTGRES_USER=odin
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=odin
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://odin:CHANGE_ME_long_random@localhost:5432/odin

# ---- Redis (Dockerized, localhost only) ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- App ----
APP_ENV=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Same origin — the browser calls /api on odin.iamcanturk.dev.
CORS_ORIGINS=https://odin.iamcanturk.dev

# ---- Embeddings ----
# local = sentence-transformers e5 (real quality, ~2GB torch); hash = no torch, non-semantic.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# ---- LLM (OpenAI-compatible; starts mocked — leave key empty until ready) ----
# OpenRouter by default. Put the real key here on the server only (never commit).
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
ENRICH_TREND_THRESHOLD=50

# ---- X browser-extension inbound ingestion ----
INGEST_TOKEN=CHANGE_ME_long_random_token
